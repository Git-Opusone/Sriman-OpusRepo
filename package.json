{
  "name": "mortgage-search-service",
  "version": "1.0.0",
  "description": "AI-powered Mortgage Title & Tax Search microservice using browser automation and OpenAI (GPT-4o-mini vision)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "setup": "npm install && npx playwright install chromium",
    "test:tx": "node scripts/tx-county-automation",
    "test:tx:resume": "node scripts/tx-county-automation --resume",
    "test:tx:single": "node scripts/tx-county-automation --county",
    "test:tx:dry": "node scripts/tx-county-automation --dry-run",
    "test:report": "node scripts/tx-county-automation --report-only",
    "report:test": "node scripts/report-tester",
    "report:test:county": "node scripts/report-tester --county",
    "report:test:summary": "node scripts/report-tester --summary"
  },
  "dependencies": {
    "axios": "^1.15.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "openai": "^4.104.0",
    "playwright": "^1.44.0",
    "playwright-extra": "^4.3.6",
    "prom-client": "^15.1.3",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  },
  "devDependencies": {
    "cheerio": "^1.2.0",
    "nodemon": "^3.1.0"
  }
}
