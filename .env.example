# ─────────────────────────────────────────────────────────────────────────────
# OpenAI API  (https://platform.openai.com)
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED — paste your OpenAI API key here
OPENAI_API_KEY=your_openai_api_key_here

# Model to use (must support vision + tool/function calling).
# gpt-4o-mini is the recommended cost-efficient vision + tool use model.
# See all models: https://platform.openai.com/docs/models
OPENAI_MODEL=gpt-4o-mini

# ─────────────────────────────────────────────────────────────────────────────
# Server settings
# ─────────────────────────────────────────────────────────────────────────────
PORT=3000
BROWSER_HEADLESS=true

# ── Search tuning (src/tax/routes.js) ─────────────────────────────────────────
# Max simultaneous county searches before new requests queue
MAX_CONCURRENT_SEARCHES=5
# Per-search timeout in milliseconds (default 3 minutes)
SEARCH_TIMEOUT_MS=180000
# How long a completed search result stays cached, in hours
CACHE_TTL_HOURS=4
# Max number of cached search results kept in memory
CACHE_MAX_SIZE=1000

# ── CapSolver CAPTCHA service (https://capsolver.com) ─────────────────────────
# Paste your Client Key from: dashboard.capsolver.com → Overview → Client Key
# Used to bypass Cloudflare Turnstile on propertytaxpayments.net counties
CAPSOLVER_API_KEY=your_capsolver_client_key_here

# ── Grafana Cloud (monitoring — set in monitoring/.env and GitHub Secrets) ────
# Find these values at: grafana.com → My Account → your stack → Details
#
# Prometheus (Mimir)
GRAFANA_PROM_URL=https://prometheus-prod-XX-prod-us-east-0.grafana.net/api/prom/push
GRAFANA_PROM_USER=123456
#
# Loki (logs)
GRAFANA_LOKI_URL=https://logs-prod-XX-prod-us-east-0.grafana.net/loki/api/v1/push
GRAFANA_LOKI_USER=789012
#
# Service account API key (needs Metrics Publisher + Logs Publisher roles)
# Create at: grafana.com → My Account → Security → Access Policies → Add access policy
GRAFANA_API_KEY=glc_eyJo...
