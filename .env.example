# ─────────────────────────────────────────────────────────────────────────────
# OpenAI API  (https://platform.openai.com)
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED — paste your OpenAI API key here
OPENAI_API_KEY=your_openai_api_key_here

# Model to use (must support vision + tool/function calling).
# gpt-4o-mini is the recommended cost-efficient vision + tool use model.
# See all models: https://platform.openai.com/docs/models
OPENAI_MODEL=gpt-4o-mini

# ─────────────────────────────────────────────────────────────────────────────
# Server settings
# ─────────────────────────────────────────────────────────────────────────────
PORT=3000
BROWSER_HEADLESS=true

# Max simultaneous Chromium browser processes (each ~400-500 MB RAM).
# Lower on small VMs, raise on beefy staging/prod servers.
MAX_CONCURRENT_SEARCHES=5

# Hard timeout per search request in milliseconds (default: 3 minutes).
# Raise if county websites in your area are consistently slow.
SEARCH_TIMEOUT_MS=180000
