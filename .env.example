# ── LLM Provider ─────────────────────────────────────────────────────────────
# Choose your backend: anthropic (default) or ollama (free, local)
LLM_PROVIDER=ollama

# Model name — leave blank to use the provider default
#   anthropic default : claude-opus-4-6
#   ollama default    : llama3.2-vision  (needs ~8 GB RAM)
LLM_MODEL=llama3.2-vision

# API key
#   anthropic : get yours at https://console.anthropic.com
#   ollama    : set to "ollama" or leave blank (no key required)
LLM_API_KEY=ollama

# Ollama server URL (only used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# ── Anthropic (only needed when LLM_PROVIDER=anthropic) ──────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
BROWSER_HEADLESS=true
