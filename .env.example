# LLM provider: 'anthropic' (default) or 'ollama'
LLM_PROVIDER=ollama

# Model to use. Must support tool/function calling.
# Ollama examples: llama3.1, qwen2.5, mistral
# Note: llama3.2-vision does NOT support tools — use llama3.1 or qwen2.5 instead.
LLM_MODEL=llama3.1

LLM_API_KEY=ollama
OLLAMA_BASE_URL=http://localhost:11434

# Required when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

PORT=3000
BROWSER_HEADLESS=true
