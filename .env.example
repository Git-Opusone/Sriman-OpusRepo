# =============================================================================
# LLM Provider Configuration
# =============================================================================
# Choose one of the supported open-source providers below.
# The app uses an OpenAI-compatible API, so switching providers is just
# a matter of changing these three variables.

# --- Provider ---
# Options: ollama | groq | together | openrouter
LLM_PROVIDER=ollama

# --- API Key ---
# Ollama (local): any non-empty string works, e.g. "ollama"
# Groq           : get free key at https://console.groq.com
# Together AI    : get key at https://api.together.xyz
# OpenRouter     : get key at https://openrouter.ai
LLM_API_KEY=ollama

# --- Model ---
# Must support BOTH vision (screenshots) AND tool/function calling.
#
# Provider        Recommended model
# -----------     -----------------------------------------------
# ollama          llama3.2-vision          (pull: ollama pull llama3.2-vision)
# groq            llama-3.2-11b-vision-preview
# together        meta-llama/Llama-3.2-11B-Vision-Instruct-Turbo
# openrouter      meta-llama/llama-3.2-11b-vision-instruct
LLM_MODEL=llama3.2-vision

# --- Base URL (optional) ---
# Only needed if you want to override the default URL for a provider,
# or if you are running Ollama on a non-standard port.
# LLM_BASE_URL=http://localhost:11434/v1

# =============================================================================
# Server
# =============================================================================
PORT=3000

# Browser headless mode: true for production, false to watch the browser during dev
BROWSER_HEADLESS=true
