# ─────────────────────────────────────────────────────────────────────────────
# Groq API  (https://console.groq.com)
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED — paste your Groq API key here
GROQ_API_KEY=your_groq_api_key_here

# Model to use (must support vision + tool/function calling on Groq).
# Default uses the larger, more accurate model.
#   llama-3.2-90b-vision-preview   <- default (recommended)
#   llama-3.2-11b-vision-preview   <- lighter / faster alternative
# See all models: https://console.groq.com/docs/models
GROQ_MODEL=llama-3.2-90b-vision-preview

# ─────────────────────────────────────────────────────────────────────────────
# Server settings
# ─────────────────────────────────────────────────────────────────────────────
PORT=3000
BROWSER_HEADLESS=true
