# ── LLM Provider ─────────────────────────────────────────────────────────────
# Choose your backend: anthropic (default) or ollama (free, local)
LLM_PROVIDER=ollama

# Model name — leave blank to use the provider default
#   anthropic default : claude-opus-4-6
#   ollama default    : llama3.2-vision  (needs ~8 GB RAM)
LLM_MODEL=llama3.2-vision

# API key
#   anthropic : get yours at https://console.anthropic.com
#   ollama    : set to "ollama" or leave blank (no key required)
LLM_API_KEY=ollama

# Ollama server URL (only used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# ── Anthropic (only needed when LLM_PROVIDER=anthropic) ──────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
BROWSER_HEADLESS=true

# ── Grafana Cloud (monitoring — set in monitoring/.env and GitHub Secrets) ────
# Find these values at: grafana.com → My Account → your stack → Details
#
# Prometheus (Mimir)
GRAFANA_PROM_URL=https://prometheus-prod-XX-prod-us-east-0.grafana.net/api/prom/push
GRAFANA_PROM_USER=123456
#
# Loki (logs)
GRAFANA_LOKI_URL=https://logs-prod-XX-prod-us-east-0.grafana.net/loki/api/v1/push
GRAFANA_LOKI_USER=789012
#
# Service account API key (needs Metrics Publisher + Logs Publisher roles)
# Create at: grafana.com → My Account → Security → Access Policies → Add access policy
GRAFANA_API_KEY=glc_eyJo...
