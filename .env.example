# ─────────────────────────────────────────────────────────────────────────────
# OpenAI API  (https://platform.openai.com)
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED — paste your OpenAI API key here
OPENAI_API_KEY=your_openai_api_key_here

# Model to use (must support vision + tool/function calling).
# gpt-4o-mini is the recommended cost-efficient vision + tool use model.
# See all models: https://platform.openai.com/docs/models
OPENAI_MODEL=gpt-4o-mini

# ─────────────────────────────────────────────────────────────────────────────
# Server settings
# ─────────────────────────────────────────────────────────────────────────────
PORT=3000
BROWSER_HEADLESS=true
