# ─────────────────────────────────────────────────────────────────────────────
# Groq API  (https://console.groq.com)
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED — paste your Groq API key here
GROQ_API_KEY=your_groq_api_key_here

# Model to use (must support vision + tool/function calling on Groq).
# Llama 4 Scout is the current recommended vision + tool use model.
# See all models: https://console.groq.com/docs/models
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# ─────────────────────────────────────────────────────────────────────────────
# Server settings
# ─────────────────────────────────────────────────────────────────────────────
PORT=3000
BROWSER_HEADLESS=true
